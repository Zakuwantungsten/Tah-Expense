# Install as /etc/tahmeed-api/tahmeed-api.env with mode 0640, root:tahmeed-api.
# Never commit the populated file.
MONGODB_URI=mongodb://tahmeed_app:REPLACE_ME@127.0.0.1:27017/tahmeed_expense?authSource=tahmeed_expense
DB_NAME=tahmeed_expense
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ISSUER=tahmeed-api
JWT_AUDIENCE=tahmeed-clients
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=[]

MONGODUMP_PATH=/usr/bin/mongodump
MONGORESTORE_PATH=/usr/bin/mongorestore
BACKUP_DIRECTORY=/var/lib/tahmeed-api/backups
BACKUP_LOCK_FILE=/var/lock/tahmeed-api/backup.lock
# Optional separate least-privilege credential; blank falls back to MONGODB_URI.
BACKUP_MONGODB_URI=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=tahmeed-expense/database-backups
BACKUP_MIN_FREE_BYTES=5368709120
BACKUP_UPLOAD_STALE_MINUTES=60
# standalone = off-hours best-effort logical dump, not PITR.
# oplog = replica-set-only mongodump --oplog mode; see README permissions.
BACKUP_CONSISTENCY_MODE=standalone
BACKUP_LOCAL_KEEP_GENERATIONS=3
BACKUP_LEASE_MINUTES=90
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
