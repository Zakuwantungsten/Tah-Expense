# Copy to tahmeed-api.env, replace every placeholder, then:
# sudo chown root:root tahmeed-api.env && sudo chmod 0600 tahmeed-api.env
MONGODB_URI=mongodb://tahmeed_app:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:27017/tahmeed_expense?authSource=tahmeed_expense
DB_NAME=tahmeed_expense
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ISSUER=tahmeed-api
JWT_AUDIENCE=tahmeed-clients
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=[]

MONGODUMP_PATH=/usr/bin/mongodump
MONGORESTORE_PATH=/usr/bin/mongorestore
BACKUP_DIRECTORY=/var/lib/tahmeed/backups
BACKUP_LOCK_FILE=/var/lib/tahmeed/backup.lock
BACKUP_MONGODB_URI=mongodb://tahmeed_backup:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:27017/tahmeed_expense?authSource=tahmeed_expense
BACKUP_CONSISTENCY_MODE=standalone
BACKUP_MIN_FREE_BYTES=5368709120
BACKUP_LEASE_MINUTES=90
BACKUP_LOCAL_KEEP_GENERATIONS=3

BACKUP_S3_BUCKET=REPLACE_BUCKET
BACKUP_S3_REGION=REPLACE_REGION
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_ACCESS_KEY_ID=REPLACE_ACCESS_KEY
BACKUP_S3_SECRET_ACCESS_KEY=REPLACE_SECRET_KEY
BACKUP_S3_PREFIX=tahmeed-expense/database-backups
BACKUP_UPLOAD_STALE_MINUTES=60
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# UTC schedules. BACKUP_WEEKLY_DAY_UTC uses Monday=0 through Sunday=6.
BACKUP_DAILY_TIME_UTC=02:00
BACKUP_WEEKLY_DAY_UTC=6
BACKUP_WEEKLY_TIME_UTC=03:00
BACKUP_MAINTENANCE_INTERVAL_MINUTES=30
BACKUP_SCHEDULER_POLL_SECONDS=60
BACKUP_SCHEDULE_STALE_MINUTES=120
# Skip unexpectedly old backup slots after a restart instead of launching huge catch-up dumps.
BACKUP_SCHEDULE_CATCHUP_MINUTES=360
